# PKGBUILD for exportsnap — prebuilt from the GitHub Release asset.
# Bare package name (upstream-maintainer convention): installs the released
# binary. No -git sibling exists, so no provides/conflicts. Refresh checksums
# and .SRCINFO with ./prepare-aur.sh before pushing to AUR.

# Maintainer: uwuclxdy <uwuclxdy@users.noreply.github.com>

pkgname=exportsnap
pkgver=0.2.0
pkgrel=1
pkgdesc="TUI that repairs a Snapchat data export: real capture dates, merged captions, media filed by conversation"
arch=('x86_64')
url="https://github.com/uwuclxdy/exportsnap"
license=('MIT' 'Apache-2.0')
depends=()
options=('!strip' '!debug')
# Sources are pinned to the tag so the install lines in package() actually
# resolve; $pkgver in each saved filename forces a re-download on a version
# bump instead of reusing a stale cached file. The binary is a bare ELF asset —
# no archive extension in the saved name, or makepkg would try to unpack it.
# THIRD-PARTY-LICENSES rides the package: the binary embeds OSM-derived
# timezone polygons and the ODbL attribution obligation (decision 35) must ship
# with it wherever the binary goes.
source=("exportsnap-linux-$CARCH-$pkgver::$url/releases/download/v$pkgver/exportsnap-linux-$CARCH"
        "LICENSE-MIT-$pkgver::$url/raw/v$pkgver/LICENSE-MIT"
        "LICENSE-APACHE-$pkgver::$url/raw/v$pkgver/LICENSE-APACHE"
        "THIRD-PARTY-LICENSES-$pkgver::$url/raw/v$pkgver/THIRD-PARTY-LICENSES")
sha256sums=('710240adc1d29d1161bbc4d51b73159c442de2f5a3060648e49dc96eba9e3694'
            'f7837932020c82b6f6d5075e43a0312f5cbf631aebb32476f039b3bc47acec43'
            '429c026d4b5ffeb625f1277ee0fd65d5a7b2808a7ea6399dd0f4534373c58ec5'
            'cc76fb2caced8e7ac6d0909c0803a52cab28c8ab1f4ba3e2b2500a871f309e21')

package() {
  install -Dm755 "$srcdir/exportsnap-linux-$CARCH-$pkgver" "$pkgdir/usr/bin/exportsnap"
  install -Dm644 "$srcdir/LICENSE-MIT-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$srcdir/LICENSE-APACHE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 "$srcdir/THIRD-PARTY-LICENSES-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES"
}
